// Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /todos/{todo} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    function validUsername(username) {
      return username is string
        && username.matches('^[A-Za-z0-9_]{3,20}$');
    }

    function profileAfterMatches(uid, usernameLower) {
      let profile = getAfter(
        /databases/$(database)/documents/publicProfiles/$(uid)
      );
      return profile.data.uid == uid
        && profile.data.usernameLower == usernameLower;
    }

    function validProfileWrite(uid) {
      return request.resource.data.keys().hasAll(['uid', 'username', 'usernameLower'])
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower'])
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && existsAfter(
          /databases/$(database)/documents/usernameClaims/$(request.resource.data.usernameLower)
        )
        && getAfter(
          /databases/$(database)/documents/usernameClaims/$(request.resource.data.usernameLower)
        ).data.uid == uid;
    }

    function validFriendUid(uid) {
      return uid is string
        && uid.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validFriendship(data, pairId) {
      let participants = data.participantUids;
      return data.keys().hasAll(['participantUids', 'requesterUid', 'recipientUid', 'status'])
        && data.keys().hasOnly(['participantUids', 'requesterUid', 'recipientUid', 'status'])
        && participants is list
        && participants.size() == 2
        && validFriendUid(participants[0])
        && validFriendUid(participants[1])
        && participants[0] < participants[1]
        && pairId == participants[0] + '~' + participants[1]
        && data.requesterUid in participants
        && data.recipientUid in participants
        && data.requesterUid != data.recipientUid
        && data.status in ['PENDING', 'ACCEPTED'];
    }

    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && uid == request.auth.uid
        && validProfileWrite(uid);
      allow update: if request.auth != null
        && uid == request.auth.uid
        && validProfileWrite(uid)
        && (request.resource.data.usernameLower == resource.data.usernameLower
          || !existsAfter(
            /databases/$(database)/documents/usernameClaims/$(resource.data.usernameLower)
          ));
      allow delete: if false;
    }

    match /usernameClaims/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && profileAfterMatches(request.auth.uid, usernameLower);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.usernameLower != usernameLower;
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && validFriendship(request.resource.data, pairId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requesterUid == request.auth.uid
        && exists(
          /databases/$(database)/documents/publicProfiles/$(request.resource.data.recipientUid)
        );
      allow update: if request.auth != null
        && validFriendship(resource.data, pairId)
        && validFriendship(request.resource.data, pairId)
        && resource.data.status == 'PENDING'
        && request.resource.data.status == 'ACCEPTED'
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null
        && validFriendship(resource.data, pairId)
        && (
          (resource.data.status == 'PENDING'
            && request.auth.uid in [resource.data.requesterUid, resource.data.recipientUid])
          || (resource.data.status == 'ACCEPTED'
            && request.auth.uid in resource.data.participantUids)
        );
    }
  }
}
